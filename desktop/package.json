{
  "name": "tv-remote",
  "version": "1.0.0",
  "private": true,
  "description": "שלט למחשב לממירי Android TV ולטלוויזיות LG webOS / Samsung Tizen",
  "main": "src/main/index.js",
  "type": "module",
  "scripts": {
    "shared": "node scripts/sync-shared.js",
    "prestart": "node scripts/sync-shared.js",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "predist": "node scripts/sync-shared.js",
    "dist": "electron-builder --mac",
    "icons": "python3 scripts/make-icons.py && bash scripts/make-appicon.sh",
    "smoke": "node scripts/smoke.js",
    "discover": "node scripts/test-discovery.js",
    "check": "node scripts/sync-shared.js && node scripts/check.js"
  },
  "dependencies": {
    "@kud/androidtv-remote": "^0.1.2",
    "bonjour-service": "^1.4.4",
    "lgtv2": "^2.0.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "protobufjs": "^8.8.0"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "productName": "TV Remote",
  "build": {
    "appId": "io.benesh.tvremote",
    "productName": "TV Remote",
    "copyright": "© Ariel Benesh",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!scripts/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "artifactName": "TV-Remote-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "TV Remote ${version}",
      "contents": [
        {
          "x": 140,
          "y": 170,
          "type": "file"
        },
        {
          "x": 400,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterPack": "scripts/adhoc-sign.cjs"
  }
}

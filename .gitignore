# ---- macOS ----
.DS_Store

# ---- desktop (Electron) ----
desktop/node_modules/
desktop/dist/
# generated by `npm run shared` from ../shared — never edit or commit
desktop/src/shared/

# ---- mobile (Flutter) ----
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/*.iml
# generated by the shared-data sync step
mobile/assets/shared/

# ---- signing: must never reach the repository ----
*.keystore
*.jks
key.properties
mobile/android/key.properties

# ---- logs / scratch ----
*.log
